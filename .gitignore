# ── colcon / ament build artifacts (regenerated by `colcon build`) ───────────
build/
install/
log/

# ── vendored upstream ─────────────────────────────────────────────────────────
# third_party/VINS-Fusion-ROS2 (incl. local QoS + SuperPoint patches and the
# DBoW vocabulary) is COMMITTED so a fresh clone builds; see docs/CONTRACT.md.

# ── generated evaluation artifacts (run scripts/run_eval.py to regenerate) ───
data/eval/

# ── recorded rosbags + crash dumps (regenerable, large) ──────────────────────
data/bags/
/bags/
core
core.*

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── ROS 2 bags ────────────────────────────────────────────────────────────────
*.bag
*.db3
*.mcap

# ── editor / OS cruft ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store

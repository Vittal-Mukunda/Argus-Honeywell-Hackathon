# ── colcon / ament build artifacts (regenerated by `colcon build`) ───────────
build/
install/
log/

# ── vendored upstream (cloned separately; symlinked into src/) ───────────────
# VINS-Fusion-ROS2 + its DBoW vocabulary live here; see docs/CONTRACT.md.
third_party/

# ── generated evaluation artifacts (run scripts/run_eval.py to regenerate) ───
data/eval/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# ── ROS 2 bags ────────────────────────────────────────────────────────────────
*.bag
*.db3
*.mcap

# ── editor / OS cruft ─────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
